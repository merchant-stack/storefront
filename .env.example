# Copy this to .env.local and fill in real values.
# .env.local is git-ignored.

# ----- Core -----
NODE_ENV=development
# DATABASE_URL — copy from your Neon project's Connection string (https://neon.tech)
# Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# REDIS_URL — copy from your Upstash Redis database (https://upstash.com)
# Use the "Redis URL" (rediss://), NOT the REST URL.
REDIS_URL=
# (Fallback for fully-offline dev: docker-compose.yml provides localhost Postgres+Redis)
# DATABASE_URL=postgresql://rustskinpay:rustskinpay@localhost:5432/rustskinpay
# REDIS_URL=redis://localhost:6379

# ----- API -----
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=replace-me-with-a-32-byte-hex-string-please

# ----- Steam (get from https://steamcommunity.com/dev/apikey) -----
STEAM_API_KEY=

# ----- Steam bot (dedicated bot account, NOT your personal Steam) -----
STEAM_BOT_USERNAME=
STEAM_BOT_PASSWORD=
STEAM_BOT_SHARED_SECRET=
STEAM_BOT_IDENTITY_SECRET=

# ----- Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys) -----
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ----- Web app -----
NEXT_PUBLIC_API_URL=http://localhost:4000
