# Caddy reverse proxy for api.rustsupply.com.
# Auto-provisions a Let's Encrypt cert on first boot — make sure the DNS A record
# already points at this server's IP, otherwise the ACME challenge will fail.

api.rustsupply.com {
	encode zstd gzip
	reverse_proxy api:4000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	log {
		output stdout
		format json
		level INFO
	}
}

# Web frontend — apex + www. Next.js handles its own security headers
# (CSP, X-Frame-Options, etc.) via next.config.mjs; Caddy just adds HSTS
# at the edge.
www.rustsupply.com {
	redir https://rustsupply.com{uri} permanent
}

rustsupply.com {
	encode zstd gzip

	# Apple Pay domain verification (Whop self-hosted flow).
	# Whop issued this hex blob; Apple fetches it via Whop to verify domain ownership.
	@apple_pay path /.well-known/apple-developer-merchantid-domain-association
	handle @apple_pay {
		header Content-Type "text/plain"
		respond "7b2276657273696f6e223a312c227073704964223a2236343641384242363234393134464232453835354239443531364642353530333338314132444446383545414643463630323336443830413044434235334632222c22637265617465644f6e223a313736303636343737373433327d" 200
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}

	log {
		output stdout
		format json
		level INFO
	}
}
