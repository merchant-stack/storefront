# Copy to /opt/rustskinpay/worker.env on the server and fill in real values.

NODE_ENV=production

# Must point at the same Supabase DB as the api
DATABASE_URL=postgresql://postgres:PASSWORD@aws-X-region.pooler.supabase.com:6543/postgres

# Must point at the same Redis as the api (self-hosted on the docker network)
REDIS_URL=redis://redis:6379

# Required — without it the catalog sync runs in mock mode
WAXPEER_API_KEY=REPLACE_ME

# --- Sync tuning (optional) ---
# DMARKET_SYNC_LIMIT=60
# DMARKET_SYNC_INTERVAL_MS=300000

WORKER_HEALTH_PORT=4001

MOCK_PAYMENTS=false

# --- Payment provider (required once CHECKOUT_DISABLED=false, for refund flow) ---
# STRIPE_SECRET_KEY=
