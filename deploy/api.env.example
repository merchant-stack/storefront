# Copy to /opt/rustskinpay/api.env on the server and fill in real values.
# This file is read by docker-compose as the api service's env_file.

NODE_ENV=production
PORT=4000

# --- External services ---
# Supabase pooler URL (port 6543), NOT the direct 5432 one
DATABASE_URL=postgresql://postgres:PASSWORD@aws-X-region.pooler.supabase.com:6543/postgres

# Self-hosted Redis on the same docker network (see docker-compose.yml)
REDIS_URL=redis://redis:6379

# --- URLs ---
WEB_ORIGIN=https://rustsupply.com
API_ORIGIN=https://api.rustsupply.com
CORS_EXTRA_ORIGINS=https://www.rustsupply.com

# --- Session / cookies ---
# Generate each independently:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# COOKIE_SECRET signs cookies; JWT_SECRET signs session JWTs. Must be different —
# sharing them lets a leak of either compromise both surfaces.
COOKIE_SECRET=REPLACE_WITH_GENERATED_SECRET
JWT_SECRET=REPLACE_WITH_ANOTHER_GENERATED_SECRET
# 'lax' is correct when web + api share the registrable domain (rustsupply.com + api.rustsupply.com)
SESSION_SAMESITE=lax

# --- Observability ---
# Required for Prometheus to scrape /metrics in production. When unset, /metrics
# 404s. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# METRICS_BEARER_TOKEN=

# --- Kill switch ---
# Keep 'true' until you wire a payment provider. NEXT_PUBLIC_CHECKOUT_DISABLED on the web build must match.
CHECKOUT_DISABLED=true
MOCK_PAYMENTS=false

# Comma-separated SteamID64 list. REQUIRED when MOCK_PAYMENTS=true in production
# — only buyers on this list can trigger checkout / mock-pay. Lets the founder
# smoke-test the live site end-to-end without exposing free skins to the world.
# Leave empty when MOCK_PAYMENTS=false.
# Example: MOCK_PAYMENTS_ALLOWED_STEAM_IDS=76561198856483940,76561198000000000
MOCK_PAYMENTS_ALLOWED_STEAM_IDS=

# --- Steam (optional, improves profile fetch) ---
# STEAM_API_KEY=

# --- Catalog tuning (optional) ---
# MAX_BUY_PRICE_MINOR=500
# MAX_LISTING_AGE_SECONDS=600

# --- Payment provider (leave blank until launch) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Merchant deposit gateway (cobalt.skin) ---
# HMAC secret cobalt.skin uses to sign POST /api/merchant/sessions requests.
# 32 random bytes hex. Must match what's set on cobalt.skin's side.
# MERCHANT_COBALT_API_SECRET=
# Comma-separated host names accepted in return_url / cancel_url. Defends
# against open-redirect.
# MERCHANT_COBALT_ALLOWED_RETURN_DOMAINS=cobalt.skin,www.cobalt.skin
# Comma-separated allowlist of cobalt.skin's egress IPs. Defence-in-depth on
# top of HMAC — empty = disabled (HMAC alone protects, suitable only for
# initial integration before IPs are known). Supports IPv4, CIDR, IPv6 exact.
# Example: MERCHANT_COBALT_ALLOWED_IPS=203.0.113.10,203.0.113.0/28,2001:db8::1
# MERCHANT_COBALT_ALLOWED_IPS=
