# Copy to /opt/rustskinpay/api.env on the server and fill in real values.
# This file is read by docker-compose as the api service's env_file.

NODE_ENV=production
PORT=4000

# --- External services ---
# Supabase pooler URL (port 6543), NOT the direct 5432 one
DATABASE_URL=postgresql://postgres:PASSWORD@aws-X-region.pooler.supabase.com:6543/postgres

# Upstash rediss:// URL with credentials embedded
REDIS_URL=rediss://default:PASSWORD@xxx.upstash.io:6379

# --- URLs ---
WEB_ORIGIN=https://rustsupply.com
API_ORIGIN=https://api.rustsupply.com
CORS_EXTRA_ORIGINS=https://www.rustsupply.com

# --- Session / cookies ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
COOKIE_SECRET=REPLACE_WITH_GENERATED_SECRET
# 'lax' is correct when web + api share the registrable domain (rustsupply.com + api.rustsupply.com)
SESSION_SAMESITE=lax

# --- Kill switch ---
# Keep 'true' until you wire a payment provider. NEXT_PUBLIC_CHECKOUT_DISABLED on Vercel must match.
CHECKOUT_DISABLED=true
MOCK_PAYMENTS=false

# --- Steam (optional, improves profile fetch) ---
# STEAM_API_KEY=

# --- Catalog tuning (optional) ---
# MAX_BUY_PRICE_MINOR=500
# MAX_LISTING_AGE_SECONDS=600

# --- Payment provider (leave blank until launch) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
